{
  "name": "creatorflow",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "description": "CreatorFlow - 以作品为中心的本地优先创作工作空间",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "rust:fmt:fix": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "npm run typecheck && npm run lint && npm run test && npm run rust:fmt && npm run rust:clippy && npm run rust:test"
  },
  "dependencies": {
    "@lucide/vue": "1.60.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "@tauri-apps/plugin-opener": "2.7.2",
    "element-plus": "2.14.7",
    "pinia": "4.1.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "eslint": "9.39.5",
    "eslint-plugin-vue": "10.11.1",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.13"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/orangefive/creatorflow.git"
  },
  "homepage": "https://github.com/orangefive/creatorflow"
}
